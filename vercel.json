{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/press",
      "destination": "/press.html"
    },
    {
      "source": "/sports",
      "destination": "/sports.html"
    },
    {
      "source": "/studios",
      "destination": "/studios.html"
    },
    {
      "source": "/clubs",
      "destination": "/clubs.html"
    }
  ],
  "headers": [
    {
      "source": "/press/(.*).pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/press.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"CTN_OxyPro_VH2_Global_Premiere_Press_Release_FINAL_2026-11-02.pdf\""
        }
      ]
    },
    {
      "source": "/preorder-accept",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ledpro.ctn-usa.com"
        }
      ],
      "destination": "/ledpro",
      "permanent": false
    }
  ]
}
