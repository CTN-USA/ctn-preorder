{
  "cleanUrls": true,
  "redirects": [{ "source": "/", "destination": "/preorder", "permanent": false }],
  "headers": [
    { "source": "/preorder-accept", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
